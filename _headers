# script-src keeps 'unsafe-inline' on purpose: Cloudflare injects an inline bot-detection
# snippet (/cdn-cgi/challenge-platform/scripts/jsd) into HTML served on lyriclike.com. Its
# token changes on every request, so it cannot be allowed by hash. No file in this repo has
# an inline script. To drop 'unsafe-inline', turn off JavaScript Detections in Cloudflare
# (Security > Bots) first, then check the console on lyriclike.com for CSP errors.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://www.googletagmanager.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' https://www.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://cloudflareinsights.com https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com

# Fonts and icons are versioned by filename, so they can be cached forever.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/icons/*
  Cache-Control: public, max-age=31536000, immutable

# The pronouncing dictionary and word list are large and effectively static.
# Regenerating either one requires a filename change to reach cached clients.
/cmudict.json
  Cache-Control: public, max-age=2592000

/cmudict.dict
  Cache-Control: public, max-age=2592000

/english-words.json
  Cache-Control: public, max-age=2592000

# The blocklist gates rhyme results, so an update needs to propagate quickly.
/blocklist.json
  Cache-Control: public, max-age=3600

# App code is not fingerprinted, so a deploy only reaches clients that
# revalidate. no-cache still allows cheap 304s once the content is unchanged.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/rhyme-core.js
  Cache-Control: no-cache

/app.js
  Cache-Control: no-cache

/auth.js
  Cache-Control: no-cache

/auth-link.js
  Cache-Control: no-cache

/auth-forms.js
  Cache-Control: no-cache

/account-security.js
  Cache-Control: no-cache

/storage.js
  Cache-Control: no-cache

/analytics.js
  Cache-Control: no-cache

/styles.css
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache
